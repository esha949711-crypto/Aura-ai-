
name: Deploy Aura AI to GitHub Pages

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}

    runs-on: ubuntu-latest

    steps:
      - name: Checkout Aura AI
        uses: actions/checkout@v4

      - name: Setup GitHub Pages
        uses: actions/configure-pages@v5

      - name: Upload Aura AI website
        uses: actions/upload-pages-artifact@v3
        with:
          path: .

      - name: Deploy Aura AI to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
